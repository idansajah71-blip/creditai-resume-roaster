# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (platform.openai.com; analysis, scoring, refund-assistant messages)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PayPal Sandbox app (developer.paypal.com; never real money while PAYPAL_ENV=sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Client id for the inline SDK buttons on /credits (NEXT_PUBLIC only, no secret)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# PayPal Sandbox buyer credentials displayed on /judges (optional; sandbox only)
NEXT_PUBLIC_PAYPAL_BUYER_EMAIL=
NEXT_PUBLIC_PAYPAL_BUYER_PASSWORD=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REPO_URL=https://github.com/your-org/creditai-resume-roaster

# Cost protection caps (see README "Security and idempotency")
AI_DAILY_LIMIT_PER_USER=20
AI_GLOBAL_DAILY_LIMIT=500
PAYPAL_MAX_ORDERS_PER_DAY=10
DEMO_SESSIONS_DAILY_LIMIT=200
# Required in production (hashes IPs for the demo-session rate limit)
DEMO_IP_SALT=change-me-in-production
