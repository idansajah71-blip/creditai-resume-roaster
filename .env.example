# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI-compatible endpoint (analysis, scoring, refund-assistant messages).
# Default is OpenAI; to use a free Gemini key instead, set:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-1.5-flash
#   OPENAI_INPUT_USD_PER_MTOK=0
#   OPENAI_OUTPUT_USD_PER_MTOK=0
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Estimated cost shown on /judges (USD per 1M tokens)
OPENAI_INPUT_USD_PER_MTOK=0.15
OPENAI_OUTPUT_USD_PER_MTOK=0.60

# PayPal Sandbox app (developer.paypal.com; never real money while PAYPAL_ENV=sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Client id for the inline SDK buttons on /credits (NEXT_PUBLIC only, no secret)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# PayPal Sandbox buyer credentials displayed on /judges (optional; sandbox only)
NEXT_PUBLIC_PAYPAL_BUYER_EMAIL=
NEXT_PUBLIC_PAYPAL_BUYER_PASSWORD=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REPO_URL=https://github.com/your-org/creditai-resume-roaster

# Cost protection caps (see README "Security and idempotency")
AI_DAILY_LIMIT_PER_USER=20
AI_GLOBAL_DAILY_LIMIT=500
PAYPAL_MAX_ORDERS_PER_DAY=10
DEMO_SESSIONS_DAILY_LIMIT=200
AGENT_MAX_ACTIONS_PER_DAY=25
# Required in production (hashes IPs for the demo-session rate limit)
DEMO_IP_SALT=change-me-in-production

# Outcome guarantee (deterministic quality bar; automatic credit refunds)
# Min keyword coverage gain (points) an analysis must reach to pass the bar
GUARANTEE_MIN_GAIN=10
# "Already strong" bar: a resume at/above this coverage passes when the rewrite does not lower it
GUARANTEE_ALREADY_STRONG=85
# Max keywords the rewrite may add to still pass the bar
GUARANTEE_MAX_ADDED_TERMS=2
# Max automatic guarantee refunds per user per 24h; beyond this, misses are waived (not refunded)
GUARANTEE_DAILY_REFUND_LIMIT=3
